# Staging backend template. Copy to backend/.env for local staging runs, or
# enter the same variable names in your backend host's secret settings.
# Keep actual credentials in backend/.env / your host's secret manager; never Git.

# Select production-style config: PostgreSQL + Flyway + schema validation.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Original target: PostgreSQL 16. Current configured Neon staging: PostgreSQL 18.6.
# Choose the production major version and keep backup clients on that same major.
# Neon Console > Project > Connect. Convert its URI to JDBC form:
# postgresql://HOST/DB?sslmode=require  -> jdbc:postgresql://HOST/DB?sslmode=require
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Generate a unique random value locally; never reuse a sample from source control.
# PowerShell: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Your deployed frontend's exact origin (no trailing slash, no wildcard).
CORS_ALLOWED_ORIGINS=
APP_FRONTEND_BASE_URL=

# Resend Dashboard > API Keys; sending domain must be verified in Resend.
# Use a sender on that verified domain, e.g. Agency App <no-reply@yourdomain.com>
APP_EMAIL_DELIVERY_MODE=resend
RESEND_API_KEY=
RESEND_FROM=

# Generate another unique random value locally. Used once to bootstrap the first Owner.
OWNER_BOOTSTRAP_SECRET=

# Optional: Google AI Studio > Get API key. Needed only for AI proposal drafting.
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# Optional: Razorpay Dashboard > Account & Settings > API Keys.
# Use test keys in staging; switch to live keys only for a live launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Razorpay Dashboard > Webhooks. Configure POST /api/v1/public/payments/webhook
# with payment.captured enabled. Choose a strong secret there and put the SAME value here.
RAZORPAY_WEBHOOK_SECRET=
