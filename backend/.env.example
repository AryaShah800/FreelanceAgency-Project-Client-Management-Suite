# Backend Environment Variables Template
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:h2:mem:freelancedb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=PostgreSQL
SPRING_DATASOURCE_DRIVER=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# JWT Secret Key (use a unique 32+ byte secret in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Online payments (required only when using Razorpay checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
