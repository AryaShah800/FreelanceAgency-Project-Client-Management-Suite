# Backend Environment Variables Template
# Copy this file to backend/.env and fill in your own values.
# backend/.env is gitignored - never commit real secrets.
SERVER_PORT=8080
# On Windows, backend/run-dev.ps1 loads this file and always uses disposable H2.
# On macOS/Linux, export JWT_SECRET in the shell before running the dev profile.
# SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:h2:mem:freelancedb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=PostgreSQL
SPRING_DATASOURCE_DRIVER=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# JWT Secret Key - REQUIRED, no default is shipped anymore.
# MUST BE AT LEAST 32 CHARACTERS LONG.
# Generate your own, e.g.: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Google Gemini AI API Key - optional, only needed for AI proposal drafting.
# Without it the app uses its built-in proposal template; end users never supply this key.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_DAILY_GENERATION_LIMIT=50
AI_MAX_OUTPUT_TOKENS=2048

# Online payments - optional, only needed to test the Razorpay checkout flow.
# Test-mode keys: Razorpay Dashboard > Settings > API Keys.
# In production, leave all three settings blank to disable payments. If either
# API key is set, configure both API keys and the separate webhook secret below.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set this after adding a webhook (Dashboard > Webhooks) pointing to
# POST /api/v1/public/payments/webhook, subscribed to "payment.captured".
# For local testing, forward events with the Razorpay CLI:
#   razorpay-cli listen --url localhost:8080/api/v1/public/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# PostgreSQL 16 / Neon production or staging (use the Neon pooled connection
# string when appropriate; keep credentials in a secret manager, not Git).
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/<database>?sslmode=require
# SPRING_DATASOURCE_USERNAME=<database-user>
# SPRING_DATASOURCE_PASSWORD=<database-password>

# Public agency signup, email verification, invitations, and password recovery.
# Configure these provider values on the backend; app users never provide API keys.
# OWNER_BOOTSTRAP_SECRET is only for the optional one-time installation bootstrap route.
OWNER_BOOTSTRAP_SECRET=
APP_FRONTEND_BASE_URL=http://localhost:5173
APP_EMAIL_DELIVERY_MODE=console
RESEND_API_KEY=
RESEND_FROM=Agency App <no-reply@example.com>
