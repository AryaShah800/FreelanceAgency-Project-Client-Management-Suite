# Frontend build-time settings. VITE_* values are public in the built JavaScript.
# Never put API keys, database credentials, JWT secrets, or payment secrets here.

# Leave blank when frontend and backend share one origin / reverse proxy; the
# app uses /api/v1. Production builds reject localhost and plaintext endpoints.
# Otherwise set the deployed HTTPS API base URL, including /api/v1.
VITE_API_BASE_URL=

# Optional WebSocket/SockJS endpoint override. Leave blank when the backend shares
# the frontend origin or VITE_API_BASE_URL contains the backend's HTTPS URL.
# Local development defaults to http://localhost:8080/ws.
VITE_WS_URL=

# Required before a production build. Use your real public HTTPS frontend origin.
VITE_PUBLIC_SITE_URL=https://app.yourdomain.com

# Required before a production build; replace with real operator details.
VITE_LEGAL_OPERATOR=Your Legal Business Name
VITE_LEGAL_JURISDICTION=Your country and state or province
VITE_SUPPORT_EMAIL=support@yourdomain.com

# Optional privacy-focused analytics. Copy the site's manual-pageview script
# URL from Plausible settings so route changes can redact invite/proposal tokens.
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SCRIPT_URL=

# Optional Sentry browser-loader URL from the Sentry JavaScript project setup.
# The public loader URL belongs in the frontend; never use a Sentry auth token.
VITE_SENTRY_LOADER_URL=

# Set true only in a separate recruiter-demo frontend deployment paired with
# a backend running SPRING_PROFILES_ACTIVE=demo. This enables public shared demo
# credentials in the browser bundle; never enable it for the business workspace.
VITE_DEMO_ACCESS_ENABLED=false
